# Build context hygiene. `backend/target/` alone is ~24 GB locally, and
# `frontend/node_modules/` is another few hundred MB — without this the daemon
# would copy all of it before the first instruction runs. Both are rebuilt
# inside the image anyway.

backend/target/
frontend/node_modules/
frontend/dist/
.pgdata/
.direnv/
.git/
.gitignore

# Secrets and local state: the container gets its configuration from the
# environment (docker run --env-file / compose), never from a baked-in .env.
.env
uploads/*
!uploads/.gitkeep

# Not needed to build the app. `*.md` only matches the top level, so the docs
# directory needs naming separately.
*.md
!README.md
docs/
flake.nix
flake.lock
justfile
bootstrap.sh
result
result-*
