# Copy to .env and adjust. Read by the backend on startup (dotenvy).
#
# ./bootstrap.sh writes this file for you, pointing at the local cluster it
# creates in .pgdata — which listens on port 5433, not 5432, so that it cannot
# collide with a system PostgreSQL:
#
#   DATABASE_URL=postgres://postgres@127.0.0.1:5433/portal
#
# The line below is the shape for a Postgres you set up yourself. Whichever you
# use, the port here must match the one the cluster was actually started on:
# a mismatch surfaces as PoolTimedOut at startup, not as a refused connection.
DATABASE_URL=postgres://portal:portal@localhost:5432/portal

# Seed admin account, created on first boot if the users table is empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now

# Where uploaded images are written (served at /uploads/*, behind the session).
# Relative paths resolve against the server's working directory, and the dev
# server runs from backend/ — hence the `../`. Without it, images written in
# development land in backend/uploads/ while the repo's uploads/ sits empty.
# Docker and systemd both set an absolute path instead.
UPLOADS_DIR=../uploads

# Max upload size in bytes (default 5 MiB, per SR-5).
MAX_UPLOAD_BYTES=5242880

# Where the API listens.
BIND_ADDR=127.0.0.1:3000

# The built frontend the API serves in production (`npm run build` output).
# In development you do not need this: Vite serves the app on :5173 and proxies
# /api here, so the API only ever answers JSON.
STATIC_DIR=../frontend/dist

# Origins allowed to send credentialed requests. Needed ONLY in development,
# where the frontend is on another port. Leave it empty in production: the SPA
# is served from the API's own origin, so no cross-origin request exists and
# the safest header set is no header set.
CORS_ORIGINS=http://localhost:5173

# `Secure` on the session cookie. Leave off for local HTTP; set to 1 behind
# TLS (SR-2). See docs/DEPLOY.md.
SECURE_COOKIE=0
