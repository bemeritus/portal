# Copy to .env and adjust. Loaded by the server on startup (dotenvy).
DATABASE_URL=postgres://portal:portal@localhost:5432/portal

# Seed admin account, created on first boot if the users table is empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now

# Where uploaded images are written (served at /uploads/*).
UPLOADS_DIR=uploads

# Max upload size in bytes (default 5 MiB, per SR-5).
MAX_UPLOAD_BYTES=5242880

# Leptos server bind address.
LEPTOS_SITE_ADDR=127.0.0.1:3000
