FoamFile { version 2.0; format ascii; class dictionary; location "system"; object snappyHexMeshDict; }

castellatedMesh true; snap false; addLayers false;
geometry {
  obstacles.stl { type triSurfaceMesh; name obstacles; }
  ac1.stl { type triSurfaceMesh; name ac1; regions { walls { name ac1_walls; } supply { name ac1_supply; } return { name ac1_return; } } }
  ac2.stl { type triSurfaceMesh; name ac2; regions { walls { name ac2_walls; } supply { name ac2_supply; } return { name ac2_return; } } }
  ac3.stl { type triSurfaceMesh; name ac3; regions { walls { name ac3_walls; } supply { name ac3_supply; } return { name ac3_return; } } }
}
castellatedMeshControls {
  maxLocalCells 2000000; maxGlobalCells 6000000; minRefinementCells 0; maxLoadUnbalance 0.1; nCellsBetweenLevels 2;
  features ( );
  refinementSurfaces {
    obstacles { level (1 1); patchInfo { type wall; } }
    ac1 { level (2 2); patchInfo { type wall; } regions { supply { level (2 2); patchInfo { type patch; } } return { level (2 2); patchInfo { type patch; } } } }
    ac2 { level (2 2); patchInfo { type wall; } regions { supply { level (2 2); patchInfo { type patch; } } return { level (2 2); patchInfo { type patch; } } } }
