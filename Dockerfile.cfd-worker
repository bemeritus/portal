# syntax=docker/dockerfile:1.7
#
# The airflow model's worker (SPEC §14.2, docs/DEPLOY.md "Airflow worker"):
# the official OpenFOAM image, pinned by digest, plus one binary that claims
# runs from Postgres and runs the OpenFOAM tools as child processes.
#
#   docker build -f Dockerfile.cfd-worker -t portal-cfd-worker .
#
# The API never talks to a container runtime: this image needs only the
# database. Changing the digest changes the numbers a run produces, so it is
# recorded with every result (CFD_IMAGE) and changed only on purpose.

ARG RUST_VERSION=1.96
# ESI OpenFOAM v2606 (opencfd/openfoam-run:2606), Ubuntu 26.04.
ARG OPENFOAM_IMAGE=opencfd/openfoam-run@sha256:4229997e74defb81548222d511b8e3b95b98305e5df41b8e88b031813fe47eeb

FROM rust:${RUST_VERSION}-bookworm AS build
WORKDIR /build/backend
COPY backend/ ./
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/build/backend/target,sharing=locked \
    cargo build --release -p portal-cfd-worker \
    && mkdir -p /out \
    && cp target/release/portal-cfd-worker /out/

FROM ${OPENFOAM_IMAGE}
ARG OPENFOAM_IMAGE
# Built on bookworm (glibc 2.36); the OpenFOAM image's glibc is newer.
COPY --from=build /out/portal-cfd-worker /usr/local/bin/portal-cfd-worker
RUN useradd --system --uid 10001 --create-home --home-dir /home/cfd --shell /usr/sbin/nologin cfd \
    && mkdir -p /var/lib/portal-cfd && chown cfd /var/lib/portal-cfd
# Case directories live here while a run is in progress and are deleted
# after post-processing; only the compact result goes to the database.
VOLUME ["/var/lib/portal-cfd"]
USER cfd
ENV CFD_IMAGE=${OPENFOAM_IMAGE} \
    FOAM_BASHRC=/usr/lib/openfoam/openfoam2606/etc/bashrc \
    CFD_WORK_DIR=/var/lib/portal-cfd \
    HOME=/home/cfd \
    RUST_LOG=info
# Supplied at run time: DATABASE_URL (required), CFD_PROCESSES,
# CFD_TIMEOUT_MIN, CFD_MAX_ITERATIONS, CFD_WORKER_NAME.
ENTRYPOINT ["/usr/local/bin/portal-cfd-worker"]
